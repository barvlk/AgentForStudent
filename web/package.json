{
  "name": "agentforstudent-web",
  "version": "1.1.0",
  "description": "AgentForStudent — Node.js backend + vanilla JS frontend + SQL database (SQLite / PostgreSQL)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/",
    "test:pg": "node --disable-warning=ExperimentalWarning --test test/api.pg.test.js",
    "db:status": "node --disable-warning=ExperimentalWarning server/cli.js status",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.65.1"
  }
}
