# انسخ هذا الملف باسم .env واملأ القيم. ملف .env لا يُرفع على git أبداً.

# مفتاح Google Gemini — من https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.3

# مفتاح تشفير البيانات (Fernet). ولّده بالأمر:  python main.py keygen
DATA_ENCRYPTION_KEY=

# إعدادات الأمان (اختيارية)
AFS_MAX_LOGIN_ATTEMPTS=5
AFS_LOCKOUT_MINUTES=15
AFS_SESSION_TIMEOUT_MINUTES=30
AFS_MIN_PASSWORD_LENGTH=8

# حساب عرض تجريبي ثابت (اختياري) — يُنشأ تلقائياً مع سجل أكاديمي ومهام، ولا تنطبق عليه سياسة كلمة المرور.
# للعرض والمناقشة فقط؛ اتركه فارغاً في أي تشغيل حقيقي.
AFS_DEMO_STUDENT_ID=
AFS_DEMO_PASSWORD=
AFS_DEMO_NAME=

# وضع العرض العام (للنشر على Streamlit Cloud): يولّد بيانات وهمية تلقائياً ويعرض بيانات الحساب التجريبي في صفحة الدخول
AFS_PUBLIC_DEMO=false
